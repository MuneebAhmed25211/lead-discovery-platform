# ─────────────────────────────────────────────────────
# Lead Discovery Platform — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────
APP_ENV=development                      # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-random-64-char-string
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR

# ── CORS ────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# ── Supabase ─────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...              # Never expose this to the browser

# ── Groq ────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.3

# ── Search Providers (at least one required) ─────────
# Fixed fallback order: Serper → Tavily. No Brave.
SERPER_API_KEY=                          # https://serper.dev
TAVILY_API_KEY=                          # https://tavily.com

# ── Rate Limiting ────────────────────────────────────
RATE_LIMIT_MAX_SEARCHES=3               # Free searches per window
RATE_LIMIT_WINDOW_DAYS=30              # Rolling window in days
RATE_LIMIT_CONTACT_URL=https://www.linkedin.com/in/muneebahmedai

# ── Cache ────────────────────────────────────────────
CACHE_ICP_TTL_HOURS=24
CACHE_DISCOVERY_TTL_HOURS=2
CACHE_P1_CRAWL_TTL_HOURS=72
CACHE_P2_ENRICH_TTL_HOURS=24
CACHE_SCORE_TTL_HOURS=48
CACHE_QUALIFY_TTL_HOURS=48
CACHE_OUTREACH_TTL_HOURS=48

# ── Crawler ──────────────────────────────────────────
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_MAX_RETRIES=2
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_USER_AGENT=LeadDiscoveryBot/1.0 (portfolio demo; contact muneebahmedai@gmail.com)
